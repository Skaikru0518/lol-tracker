@using summon.Changelog

@* One changelog entry on the vertical timeline: date, then a card with title, summary and category count chips *@
<li class="relative pb-8 pl-8 last:pb-0">
    <span class="absolute bottom-0 left-[0.4rem] top-5 w-px bg-border"></span>
    <span class="absolute left-0 top-1.5 size-3.5 rounded-full border-2 border-background @(Latest ? "bg-primary" : "bg-muted-foreground")"></span>
    <p class="mb-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">@Changelogs.FormatDate(Entry.Date, longMonth: true)</p>
    <a href="/changelog/@Entry.Slug" class="group block rounded-lg border bg-card p-5 transition-colors hover:border-primary/40">
        <h2 class="text-lg font-bold text-foreground transition-colors group-hover:text-primary">@Entry.Title</h2>
        <p class="mt-1.5 line-clamp-2 text-sm text-muted-foreground">@Entry.Summary</p>
        <div class="mt-3 flex flex-wrap gap-1.5">
            @foreach (var (category, count) in Changelogs.CategoryCounts(Entry))
            {
                <Chip Color="@Changelogs.Categories[category].Color">@Changelogs.CategoryLabel(category, count)</Chip>
            }
        </div>
    </a>
</li>

@code {
    [Parameter, EditorRequired] public required ChangelogEntry Entry { get; set; }
    [Parameter] public bool Latest { get; set; }
}
