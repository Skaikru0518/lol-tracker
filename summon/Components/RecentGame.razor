@using summon.Accounts
@using summon.Riot

<div class="flex items-center gap-3 rounded-lg border-l-4 bg-card px-3 py-2 @(Game.Win ? "border-win" : "border-loss")">
    <img src="@DataDragon.ChampionIcon(Game.ChampionName)" alt="@Game.ChampionName" class="size-10 rounded-md" />
    <SpellIcons DataDragon="DataDragon" Spell1="Game.Spell1" Spell2="Game.Spell2" />
    <div class="w-28">
        <p class="text-sm font-semibold @(Game.Win ? "text-win" : "text-loss")">@(Game.Win ? "Victory" : "Defeat")</p>
        <p class="text-2xs text-muted-foreground">@Queues.Name(Game.QueueId) · @Duration</p>
    </div>
    <p class="w-24 text-sm font-semibold">@Game.Kills / <span class="text-loss">@Game.Deaths</span> / @Game.Assists</p>
    <p class="w-14 text-xs text-muted-foreground">@Game.Cs CS</p>
    <ItemSlots DataDragon="DataDragon" Items="Game.Items" />
    <p class="ml-auto text-2xs text-muted-foreground">@Played</p>
</div>

@code {
    [Parameter, EditorRequired] public required MatchRow Game { get; set; }
    [Parameter, EditorRequired] public required DataDragonData DataDragon { get; set; }

    private string Duration => TimeSpan.FromSeconds(Game.GameDuration).ToString(@"m\:ss");
    private string Played => DateTimeOffset.FromUnixTimeMilliseconds(Game.GameCreation).LocalDateTime.ToString("MMM d, HH:mm");
}
