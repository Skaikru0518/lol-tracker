@page "/match/{MatchId}"
@attribute [StreamRendering]
@using summon.Accounts
@using summon.Data
@inject MatchService Games
@inject RankedService RankedService
@inject DataDragon DataDragon

<PageTitle>Match | Summon.gg</PageTitle>

@if (notFound)
{
    <div class="mx-auto max-w-6xl px-4 py-6">
        <Panel>
            <EmptyState Title="Match not found" Description="It may be too old or Riot could not be reached.">
                <Action>
                    <a href="/" class="text-sm font-medium text-primary hover:underline">Back to search</a>
                </Action>
            </EmptyState>
        </Panel>
    </div>
}
else if (match is null || dataDragon is null)
{
    <div class="mx-auto max-w-6xl space-y-4 px-4 py-6">
        <Skeleton Class="h-36" />
        <Skeleton Class="h-96" />
    </div>
}
else
{
    var arena = Queues.IsArena(match.Info.QueueId);
    <div class="mx-auto max-w-6xl space-y-4 px-4 py-6">
        <MatchHero Match="match" Player="@match.Info.Participants.FirstOrDefault(p => p.Puuid == Puuid)"
                   AvgRank="@(arena ? null : Ranks.Average(ranks, match.Info.QueueId))" />
        <Panel>
            @if (arena)
            {
                <ArenaScoreboard Participants="match.Info.Participants" DataDragon="dataDragon" HighlightPuuid="@Puuid" ShowItems="true" />
            }
            else
            {
                <MirroredScoreboard Match="match" DataDragon="dataDragon" HighlightPuuid="@Puuid" Ranks="ranks" RanksLoading="ranks is null" />
            }
        </Panel>
    </div>
}

@code {
    [Parameter] public required string MatchId { get; set; }
    [SupplyParameterFromQuery] public string? Puuid { get; set; }

    private RiotMatch? match;
    private DataDragonData? dataDragon;
    private Dictionary<string, List<RankedEntry>>? ranks;
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            dataDragon = await DataDragon.GetAsync();
            match = await Games.GetMatchAsync(MatchId);
        }
        catch (HttpRequestException)
        {
            // Unknown ids, malformed ids and an unreachable Riot all land on the same message, like the original
            notFound = true;
            return;
        }

        if (Queues.IsArena(match.Info.QueueId)) return;

        // The page streams the scoreboard first; the ranks fill in once Riot answers
        StateHasChanged();
        try
        {
            ranks = await RankedService.GetBatchAsync(Queues.PlatformOf(MatchId), match.Info.Participants.Select(p => p.Puuid).Distinct().ToList());
        }
        catch (HttpRequestException)
        {
            ranks = [];
        }
    }
}
