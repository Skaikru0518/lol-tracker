@page "/match/{MatchId}"
@attribute [StreamRendering]
@using summon.Accounts
@inject MatchService Games
@inject DataDragon DataDragon

<PageTitle>Match | Summon.gg</PageTitle>

@if (notFound)
{
    <div class="mx-auto max-w-6xl px-4 py-6">
        <Panel>
            <EmptyState Title="Match not found" Description="It may be too old or Riot could not be reached.">
                <Action>
                    <a href="/" class="text-sm font-medium text-primary hover:underline">Back to search</a>
                </Action>
            </EmptyState>
        </Panel>
    </div>
}
else if (match is null || dataDragon is null)
{
    <div class="mx-auto max-w-6xl space-y-4 px-4 py-6">
        <Skeleton Class="h-36" />
        <Skeleton Class="h-96" />
    </div>
}
else
{
    <div class="mx-auto max-w-6xl space-y-4 px-4 py-6">
        <MatchHero Match="match" Player="@match.Info.Participants.FirstOrDefault(p => p.Puuid == Puuid)" />
        <Panel>
            <MirroredScoreboard Match="match" DataDragon="dataDragon" HighlightPuuid="@Puuid" />
        </Panel>
    </div>
}

@code {
    [Parameter] public required string MatchId { get; set; }
    [SupplyParameterFromQuery] public string? Puuid { get; set; }

    private RiotMatch? match;
    private DataDragonData? dataDragon;
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            dataDragon = await DataDragon.GetAsync();
            match = await Games.GetMatchAsync(MatchId);
        }
        catch (HttpRequestException)
        {
            // Unknown ids, malformed ids and an unreachable Riot all land on the same message, like the original
            notFound = true;
        }
    }
}
