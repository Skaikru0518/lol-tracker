@page "/summoner/{Slug}"
@attribute [StreamRendering]
@using System.Net
@using summon.Accounts
@using summon.Data
@using summon.Riot
@inject AccountService Accounts
@inject RankedService Ranked
@inject MatchService Games
@inject DataDragon DataDragon

<PageTitle>@(account is null ? "Summoner" : $"{account.GameName}#{account.TagLine}") | Summon.gg</PageTitle>

<section class="mx-auto max-w-7xl px-4 py-10">
    @if (notFound)
    {
        <h1 class="text-2xl font-bold">Summoner not found</h1>
        <p class="mt-2 text-sm text-muted-foreground">No Riot ID matches "@Slug".</p>
    }
    else if (account is null)
    {
        <p class="text-sm text-muted-foreground">Loading…</p>
    }
    else
    {
        <h1 class="text-3xl font-bold tracking-tight">
            @account.GameName <span class="text-lg font-medium text-muted-foreground">#@account.TagLine</span>
        </h1>
        <p class="mt-1 text-sm text-muted-foreground">
            @(account.Platform switch {"eun1" => "EUNE", "euw1" => "EUW", null => "Unknown server", var other => other.ToUpperInvariant() })
        </p>
        <p class="mt-1 font-mono text-xs text-muted-foreground">@account.Puuid</p>
        <div class="mt-6 grid max-w-xl gap-4 sm:grid-cols-2">
            <RankedCard QueueName="Ranked Solo/Duo" Entry="@ranked.FirstOrDefault(e => e.QueueType == "RANKED_SOLO_5x5")" />
            <RankedCard QueueName="Ranked Flex" Entry="@ranked.FirstOrDefault(e => e.QueueType == "RANKED_FLEX_SR")" />
        </div>
        <h2 class="mt-8 text-sm font-semibold">Recent games</h2>
        <div class="mt-3 grid max-w-3xl gap-2">
            @if (dataDragon is not null)
            {
                @foreach (var game in games)
                {
                    <RecentGame Game="game" DataDragon="dataDragon" @key="game.MatchId" />
                }
            }
        </div>
    }
</section>

@code {
    [Parameter] public required string Slug { get; set; }

    private Account? account;
    private bool notFound;
    private List<RankedEntry> ranked = [];
    private List<MatchRow> games = [];
    private DataDragonData? dataDragon;

    protected override async Task OnInitializedAsync()
    {
        var separator = Slug.LastIndexOf('-');
        if (separator <= 0 || separator == Slug.Length - 1)
        {
            notFound = true;
            return;
        }

        try
        {
            account = await Accounts.AccountAsync(Slug[..separator], Slug[(separator + 1)..]);
            notFound = account is null;

            if (account?.Platform is not null)
                ranked = await Ranked.GetAsync(account) ?? [];

            if (account is not null)
            {
                dataDragon = await DataDragon.GetAsync();
                games = await Games.GetRecentAsync(account);
            }
        }
        catch (HttpRequestException e) when (e.StatusCode == HttpStatusCode.NotFound)
        {
            notFound = true;
        }
    }
}