@using summon.Search
@inject IJSRuntime JS

@* Recent searches (this browser's localStorage) as chips linking to each profile, with a clear action *@
@if (history.Count > 0)
{
    <div class="flex flex-wrap items-center gap-1.5">
        @foreach (var item in history)
        {
            if (SearchQuery.ParseRiotId(item.RiotId) is not { } riotId) continue;
            <a href="/summoner/@Format.SummonerSlug(riotId.GameName, riotId.TagLine)" @key="item.RiotId"
               class="inline-flex h-7 items-center rounded-full border bg-card px-3 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-foreground">
                @item.RiotId
                <span class="ml-1.5 text-3xs font-semibold">@Platforms.ByKey(item.Platform).Label</span>
            </a>
        }
        <button type="button" @onclick="ClearAsync"
                class="inline-flex h-7 items-center gap-1 rounded-full px-2 text-xs text-muted-foreground transition-colors hover:text-foreground">
            @* Lucide "x" icon *@
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3" aria-hidden="true">
                <path d="M18 6 6 18" />
                <path d="m6 6 12 12" />
            </svg>
            Clear
        </button>
    </div>
}

@code {
    private const string HistoryKey = "summon-gg-search-history";

    private List<(string RiotId, string Platform)> history = [];

    // shortcut: read once when the page opens; the original also follows changes from other tabs
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            history = SearchQuery.ParseHistory(await JS.InvokeAsync<string?>("localStorage.getItem", HistoryKey));
            if (history.Count > 0) StateHasChanged();
        }
        catch (JSException)
        {
            // Storage can be blocked; no chips then
        }
    }

    private async Task ClearAsync()
    {
        history = [];
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", HistoryKey);
        }
        catch (JSException)
        {
            // Storage can be blocked; the chips are gone for this page anyway
        }
    }
}
