@using summon.Accounts
@inject IServiceScopeFactory ScopeFactory

<Panel>
    <PanelHeader Title="Most played">
        <Actions>
            <div class="relative">
                <button type="button" data-slot="select-trigger" data-size="sm" class="@TriggerClass" @onclick="() => open = !open"
                        aria-haspopup="listbox" aria-expanded="@(open ? "true" : "false")">
                    <span data-slot="select-value">@QueueOptions.First(o => o.Value == queue).Label</span>
                    @* Up/down chevrons, the select trigger icon *@
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none size-3.5 text-muted-foreground" aria-hidden="true">
                        <path d="m7 15 5 5 5-5" />
                        <path d="m7 9 5-5 5 5" />
                    </svg>
                </button>
                @if (open)
                {
                    @* A transparent layer under the list closes it on any outside click *@
                    <div class="fixed inset-0 z-40" @onclick="() => open = false"></div>
                    <div role="listbox" class="absolute right-0 top-full z-50 mt-1 min-w-32 overflow-hidden rounded-lg bg-popover text-popover-foreground shadow-md ring-1 ring-foreground/10">
                        @foreach (var option in QueueOptions)
                        {
                            <button type="button" role="option" aria-selected="@(option.Value == queue ? "true" : "false")" @onclick="() => SelectAsync(option.Value)"
                                    class="relative flex min-h-7 w-full cursor-default items-center gap-2 rounded-md px-2 py-1 text-left text-xs/relaxed select-none hover:bg-accent hover:text-accent-foreground">
                                @if (option.Value == queue)
                                {
                                    <span class="pointer-events-none absolute right-2 flex items-center justify-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none size-3.5" aria-hidden="true">
                                            <path d="M5 14 8.5 17.5 19 6.5" />
                                        </svg>
                                    </span>
                                }
                                @option.Label
                            </button>
                        }
                    </div>
                }
            </div>
        </Actions>
    </PanelHeader>
    @if (stats is null)
    {
        <PanelBody Class="space-y-3">
            @for (var i = 0; i < 3; i++)
            {
                <Skeleton Class="h-9" />
            }
        </PanelBody>
    }
    else if (stats.Count == 0)
    {
        <EmptyState Title="No games in this queue" />
    }
    else
    {
        var top = stats.Take(5).ToList();
        var maxGames = top[0].Games;
        <PanelBody Class="space-y-3">
            @foreach (var s in top)
            {
                <div class="flex items-center gap-3">
                    <ChampionIcon DataDragon="DataDragon" ChampionName="@s.ChampionName" Size="32" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline justify-between gap-2 text-sm">
                            <span class="truncate font-semibold text-foreground">@DataDragon.ChampionName(s.ChampionName)</span>
                            <span class="text-xs text-muted-foreground">@s.Kda.ToString(System.Globalization.CultureInfo.InvariantCulture) KDA</span>
                        </div>
                        <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-primary" style="width: @((100.0 * s.Games / maxGames).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        </div>
                    </div>
                    <div class="w-12 text-right text-sm">
                        <p class="font-semibold text-foreground">@s.Games</p>
                        <p class="text-xs @(s.WinRate >= 50 ? "text-win" : "text-loss")">@((int)Math.Floor(s.WinRate + 0.5))%</p>
                    </div>
                </div>
            }
            <a href="@ChampionsPath" data-enhance-nav="false" @onclick="OnShowAll" @onclick:preventDefault class="block text-center text-xs font-medium text-primary hover:underline">See all champions &rarr;</a>
        </PanelBody>
    }
</Panel>

@code {
    [Parameter, EditorRequired] public required string Puuid { get; set; }
    [Parameter, EditorRequired] public required string ChampionsPath { get; set; }
    // Switches to the Champions tab in place; the href stays for new-tab clicks
    [Parameter] public EventCallback OnShowAll { get; set; }
    [Parameter, EditorRequired] public required DataDragonData DataDragon { get; set; }
    // Bumped by the profile after each load, so a refresh also reloads these stats
    [Parameter] public int LoadVersion { get; set; }

    private static readonly (string Value, string Label)[] QueueOptions =
    [
        ("all", "All queues"),
        ("solo", "Ranked Solo"),
        ("flex", "Ranked Flex"),
        ("premade", "Ranked 5s"),
    ];

    // The shadcn SelectTrigger classes, size "sm", with this panel's "h-7 text-xs" merged in
    private const string TriggerClass =
        "flex w-fit items-center justify-between gap-1.5 rounded-md border border-input bg-input/20 px-2 py-1.5 whitespace-nowrap transition-colors outline-none " +
        "focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30 disabled:cursor-not-allowed disabled:opacity-50 data-[size=default]:h-7 data-[size=sm]:h-6 " +
        "*:data-[slot=select-value]:line-clamp-1 *:data-[slot=select-value]:flex *:data-[slot=select-value]:items-center *:data-[slot=select-value]:gap-1.5 " +
        "dark:bg-input/30 dark:hover:bg-input/50 h-7 text-xs";

    private string queue = "solo";
    private bool open;
    private List<ChampionStat>? stats;
    private int loadedVersion = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (LoadVersion == loadedVersion) return;
        loadedVersion = LoadVersion;
        await LoadAsync();
    }

    private async Task SelectAsync(string value)
    {
        open = false;
        if (value == queue) return;
        queue = value;
        stats = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Runs inside the circuit, so it opens its own scope like the profile's loads do
        await using var scope = ScopeFactory.CreateAsyncScope();
        stats = await scope.ServiceProvider.GetRequiredService<MatchService>().GetChampionStatsAsync(Puuid, queue);
    }
}
