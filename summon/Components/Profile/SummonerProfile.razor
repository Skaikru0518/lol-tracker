@using System.Net
@using summon.Accounts
@using summon.Data
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JS

@if (notFound)
{
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
        <h1 class="text-2xl font-bold">Summoner not found</h1>
        <p class="mt-2 text-sm text-muted-foreground">No Riot ID matches "@Slug".</p>
    </div>
}
else if (failed && account is null)
{
    @* shortcut: the original shows its error screen here; switch when that page exists *@
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
        <h1 class="text-2xl font-bold">Riot could not be reached</h1>
        <p class="mt-2 text-sm text-muted-foreground">Try again in a moment.</p>
    </div>
}
else
{
    @if (account is not null)
    {
        <SummonerHero Account="account" Ranked="ranked" Summoner="summoner" DataDragon="dataDragon" SplashChampion="@splashChampion"
                      Refreshing="refreshing" OnRefresh="RefreshAsync" />
    }
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <SummonerTabs BasePath="@BasePath" Active="@tab" OnSelect="t => { tab = t; champion = null; }" />
        <div class="py-4 lg:py-6">
            @if (tab == "")
            {
                @if (account is not null)
                {
                    <AchievementPreview Account="account" BasePath="@BasePath" LoadVersion="loadVersion" OnShowAll="ShowAchievementsAsync" />
                }
                <div class="grid gap-4 lg:grid-cols-[330px_minmax(0,1fr)]">
                    <div class="space-y-4">
                        @foreach (var queueType in Ranks.QueueTypes)
                        {
                            if (ranked is null)
                            {
                                <Skeleton Class="h-36" />
                            }
                            else
                            {
                                <RankedPanel QueueType="@queueType" Entry="@ranked.FirstOrDefault(e => e.QueueType == queueType)"
                                             Snapshots="@lpHistory?.GetValueOrDefault(queueType)" />
                            }
                        }
                        @if (riftMatches is not null && account is not null)
                        {
                            <RolesPerformancePanel Matches="riftMatches" Puuid="@account.Puuid" />
                        }
                        else
                        {
                            <Skeleton Class="h-72" />
                        }
                        @if (account is not null && dataDragon is not null)
                        {
                            <MostPlayedPanel Puuid="@account.Puuid" DataDragon="dataDragon" LoadVersion="loadVersion"
                                             ChampionsPath="@($"{BasePath}/champions")" OnShowAll="ShowChampionsAsync" />
                        }
                        @if (recentMatches is not null && account is not null && dataDragon is not null)
                        {
                            <RecentlyPlayedPanel Matches="recentMatches" Puuid="@account.Puuid" DataDragon="dataDragon" />
                        }
                    </div>
                    <div class="min-w-0 space-y-4">
                        @if (dataDragon is not null)
                        {
                            <RecentPerformancePanel Summary="recentSummary" DataDragon="dataDragon" />
                        }
                        else
                        {
                            <Skeleton Class="h-64" />
                        }
                        <MatchList Games="games" DataDragon="dataDragon" Puuid="@(account?.Puuid ?? "")" LpChanges="lpChanges" Performance="performance" Matches="matchesById"
                                   HasMore="hasMore" LoadingMore="loadingMore" OnLoadMore="LoadMoreAsync" />
                    </div>
                </div>
            }
            else if (tab == "champions" && account is not null && dataDragon is not null && champion is not null)
            {
                <ChampionDetail Account="account" Champion="@champion" DataDragon="dataDragon" BasePath="@BasePath" LoadVersion="loadVersion"
                                OnBack="ShowChampionsAsync" />
            }
            else if (tab == "champions" && account is not null && dataDragon is not null)
            {
                <ChampionsTab Account="account" DataDragon="dataDragon" BasePath="@BasePath" LoadVersion="loadVersion"
                              OnSelectChampion="ShowChampionAsync" />
            }
            else if (tab == "lp" && account is not null)
            {
                <LpHistoryTab Puuid="@account.Puuid" LoadVersion="loadVersion" />
            }
            else if (tab == "achievements" && account is not null)
            {
                <AchievementsTab Puuid="@account.Puuid" LoadVersion="loadVersion" />
            }
            else
            {
                @* shortcut: these tabs are ported in their own steps; until then they say so *@
                <Panel>
                    <EmptyState Title="Coming soon" Description="This tab is not ported to the C# version yet." />
                </Panel>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public required string Slug { get; set; }
    [Parameter] public string Tab { get; set; } = "";
    [Parameter] public string? Champion { get; set; }

    private Account? account;
    private bool notFound;
    private bool failed;
    private bool refreshing;
    private List<RankedEntry>? ranked;
    private List<MatchRow>? games;
    private DataDragonData? dataDragon;
    private RiotSummoner? summoner;
    private string? splashChampion;
    private Dictionary<string, List<LpSnapshot>>? lpHistory;
    private Dictionary<string, int>? lpChanges;
    private List<RiotMatch>? riftMatches;
    private List<RiotMatch>? recentMatches;
    private Dictionary<string, RiotMatch>? matchesById;
    private int loadVersion;
    private Dictionary<string, PerformanceScore>? performance;
    private RecentSummary? recentSummary;
    // The tab is the profile's own state after the first render, so switching tabs never reloads the hero
    private string tab = "";
    private string? champion;

    private string BasePath => $"/summoner/{Uri.EscapeDataString(Slug)}";

    /// <summary>Switches tab (and champion page) in place: only the address bar changes, like the tab links.</summary>
    private async Task NavigateAsync(string toTab, string? toChampion)
    {
        var url = BasePath + (toTab == "" ? "" : $"/{toTab}") + (toChampion is null ? "" : $"/{Uri.EscapeDataString(toChampion)}");
        await JS.InvokeVoidAsync("history.pushState", null, "", url);
        tab = toTab;
        champion = toChampion;
    }

    private Task ShowChampionsAsync() => NavigateAsync("champions", null);

    private Task ShowChampionAsync(string name) => NavigateAsync("champions", name);

    private Task ShowAchievementsAsync() => NavigateAsync("achievements", null);

    // Riot pages match ids 50 at a time; the overview holds the first page, "Load more" asks for the next ones
    private const int RiotPage = 50;
    private int nextStart = RiotPage;
    private bool hasMore;
    private bool loadingMore;

    // Read once before the load starts: OnParametersSet would run only after the whole load and undo a tab picked meanwhile
    protected override void OnInitialized()
    {
        tab = Tab;
        champion = Champion;
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task RefreshAsync()
    {
        if (refreshing) return;
        refreshing = true;
        StateHasChanged();
        try
        {
            await LoadAsync();
        }
        finally
        {
            refreshing = false;
        }
    }

    // Fields are replaced as each piece arrives and never cleared, so a refresh keeps showing the old data instead of skeletons
    private async Task LoadAsync()
    {
        var separator = Slug.LastIndexOf('-');
        if (separator <= 0 || separator == Slug.Length - 1)
        {
            notFound = true;
            return;
        }

        // This component lives as long as the circuit, so each load gets its own scope (and DbContext) like a request would
        await using var scope = ScopeFactory.CreateAsyncScope();
        var accounts = scope.ServiceProvider.GetRequiredService<AccountService>();
        var rankedService = scope.ServiceProvider.GetRequiredService<RankedService>();
        var matchService = scope.ServiceProvider.GetRequiredService<MatchService>();
        var dataDragonService = scope.ServiceProvider.GetRequiredService<DataDragon>();
        var performanceService = scope.ServiceProvider.GetRequiredService<PerformanceService>();

        try
        {
            var loaded = await accounts.AccountAsync(Slug[..separator], Slug[(separator + 1)..]);
            if (loaded is null)
            {
                notFound = true;
                return;
            }

            account = loaded;
            dataDragon = await dataDragonService.GetAsync();
            summoner = await accounts.SummonerAsync(loaded);
            var topChampionId = await accounts.TopChampionIdAsync(loaded);
            splashChampion = topChampionId is { } id ? dataDragon.ChampionIds.GetValueOrDefault(id) : null;
            StateHasChanged();

            ranked = loaded.Platform is null ? [] : await rankedService.GetAsync(loaded) ?? [];
            StateHasChanged();

            lpHistory = await rankedService.GetLpHistoryAsync(loaded.Puuid);
            StateHasChanged();

            games = await matchService.GetRecentAsync(loaded);
            lpChanges = LpEstimate.ForRows(games, lpHistory);
            // A load starts over from the first page, so pages added earlier by "Load more" are dropped
            nextStart = RiotPage;
            hasMore = games.Count >= RiotPage;
            StateHasChanged();

            var stored = await matchService.GetProfileMatchesAsync(loaded.Puuid);
            riftMatches = stored.Rift;
            recentMatches = stored.Recent;
            matchesById = stored.Recent.ToDictionary(m => m.Metadata.MatchId);
            StateHasChanged();

            performance = await performanceService.ScoreAsync(recentMatches, loaded.Puuid);
            recentSummary = await performanceService.RecentAsync(stored.Ranked, loaded.Puuid);
            loadVersion++;
            failed = false;
        }
        catch (HttpRequestException e) when (e.StatusCode == HttpStatusCode.NotFound && account is null)
        {
            notFound = true;
        }
        catch (HttpRequestException)
        {
            // An exception here would end the circuit; a failed refresh keeps the data already on screen
            failed = true;
        }
    }

    /// <summary>The next 50 games after the ones shown, with their scores, LP changes and documents for the expanded rows.</summary>
    private async Task LoadMoreAsync()
    {
        if (loadingMore || refreshing || account is null || games is null) return;
        loadingMore = true;
        StateHasChanged();
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var matchService = scope.ServiceProvider.GetRequiredService<MatchService>();
            var performanceService = scope.ServiceProvider.GetRequiredService<PerformanceService>();

            // Null means Riot could not be reached: nothing changes and the button stays for another try
            if (await matchService.GetPageAsync(account, nextStart) is not { } page) return;
            // A page with games that failed to download is asked for again on the next click, so the list has no gaps
            if (page.Complete) nextStart += RiotPage;
            hasMore = page.HasMore || !page.Complete;

            var shown = games.Select(g => g.MatchId).ToHashSet();
            var added = page.Rows.Where(r => !shown.Contains(r.MatchId)).ToList();
            if (added.Count == 0) return;

            // Sorted, because a retried page can bring games older than the newest ones of that page shown before
            games = [.. games.Concat(added).OrderByDescending(g => g.GameCreation)];
            lpChanges = LpEstimate.ForRows(games, lpHistory ?? []);
            var documents = await matchService.GetDocumentsAsync(account.Puuid, added.Select(r => r.MatchId).ToArray());
            matchesById = new Dictionary<string, RiotMatch>((matchesById ?? []).Concat(documents));
            var scores = await performanceService.ScoreAsync(documents.Values, account.Puuid);
            performance = new Dictionary<string, PerformanceScore>((performance ?? []).Concat(scores));
        }
        finally
        {
            loadingMore = false;
        }
    }

}
