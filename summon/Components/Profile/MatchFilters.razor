<div class="flex flex-wrap items-center gap-1.5">
    @foreach (var (value, label) in Chips)
    {
        <button type="button" @onclick="() => OnQueueChange.InvokeAsync(value)"
                class="h-7 rounded-md border px-2.5 text-xs font-medium transition-colors @(Queue == value ? "border-primary/50 bg-primary/15 text-foreground" : "text-muted-foreground hover:text-foreground")">
            @label
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public required string Queue { get; set; }
    [Parameter] public EventCallback<string> OnQueueChange { get; set; }

    private static readonly (string Value, string Label)[] Chips = [
        ("all", "All"),
        ("solo", "Solo"),
        ("flex", "Flex"),
        ("premade", "5s"),
        ("normal", "Normal"),
        ("aram", "ARAM"),
        ("mayhem", "Mayhem"),
        ("arena", "Arena"),
        ("event", "Event"),
    ];
}