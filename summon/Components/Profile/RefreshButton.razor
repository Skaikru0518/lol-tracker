@implements IDisposable

<div class="flex items-center gap-2">
    <span class="font-mono text-xs tabular-nums text-muted-foreground">@(secondsLeft / 60):@((secondsLeft % 60).ToString("00"))</span>
    <button type="button" data-slot="button" @onclick="Refresh" disabled="@(Refreshing || cooldownLeft > 0)"
            title="@(cooldownLeft > 0 ? "Chill down..." : "Refresh data")" class="@ButtonClass">
        @* Lucide "refresh-cw" icon *@
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 @(Refreshing ? "animate-spin" : "")" aria-hidden="true">
            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
            <path d="M21 3v5h-5" />
            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
            <path d="M8 16H3v5" />
        </svg>
        Update
    </button>
</div>

@code {
    [Parameter] public bool Refreshing { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private const int IntervalSeconds = 300;
    private const int CooldownSeconds = 180;

    // The shadcn Button classes for variant "outline", size "sm", already merged
    private const string ButtonClass =
        "group/button inline-flex shrink-0 items-center justify-center gap-1 rounded-md border border-border bg-clip-padding px-2 h-6 text-xs/relaxed font-medium whitespace-nowrap " +
        "transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30 active:translate-y-px " +
        "disabled:pointer-events-none disabled:opacity-50 hover:bg-input/50 hover:text-foreground dark:bg-input/30";

    private DateTime deadline = DateTime.UtcNow.AddSeconds(IntervalSeconds);
    private DateTime cooldownUntil;
    private int secondsLeft = IntervalSeconds;
    private int cooldownLeft;
    private readonly CancellationTokenSource stop = new();

    protected override void OnAfterRender(bool firstRender)
    {
        // Only the interactive render gets here, so a prerendered copy never starts a timer
        if (firstRender) _ = TickAsync();
    }

    private async Task TickAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(stop.Token))
            {
                if (DateTime.UtcNow >= deadline)
                {
                    deadline = DateTime.UtcNow.AddSeconds(IntervalSeconds);
                    await OnRefresh.InvokeAsync();
                }
                secondsLeft = SecondsUntil(deadline);
                cooldownLeft = SecondsUntil(cooldownUntil);
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task Refresh()
    {
        await OnRefresh.InvokeAsync();
        deadline = DateTime.UtcNow.AddSeconds(IntervalSeconds);
        cooldownUntil = DateTime.UtcNow.AddSeconds(CooldownSeconds);
        secondsLeft = IntervalSeconds;
        cooldownLeft = CooldownSeconds;
    }

    private static int SecondsUntil(DateTime time) => Math.Max(0, (int)Math.Ceiling((time - DateTime.UtcNow).TotalSeconds));

    public void Dispose() => stop.Cancel();
}
