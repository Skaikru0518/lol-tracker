@using summon.Data

<Panel>
    <PanelHeader Title="@Ranks.QueueTitle(QueueType)" />
    <PanelBody>
        @if (Entry is not null)
        {
            <div class="flex items-center gap-4">
                <RankEmblem Tier="@Entry.Tier" Size="64" />
                <div class="min-w-0">
                    <p class="text-lg font-bold" style="color: @Ranks.Color(Entry.Tier)">
                        @Ranks.Label(Entry.Tier, Entry.Rank)
                        <span class="ml-1.5 text-sm font-medium text-muted-foreground">@Entry.LeaguePoints LP</span>
                    </p>
                    <p class="text-sm">
                        <span class="text-win">@(Entry.Wins)W</span>
                        <span class="text-loss">@(Entry.Losses)L</span><span class="text-muted-foreground"> · @Format.Percent(Entry.Wins, Math.Max(Entry.Wins + Entry.Losses, 1))%</span>
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="flex items-center gap-4">
                <RankEmblem Tier="null" Size="48" />
                <p class="text-sm text-muted-foreground">Unranked</p>
            </div>
        }
    </PanelBody>
</Panel>

@code {
    [Parameter, EditorRequired] public required string QueueType { get; set; }
    [Parameter] public RankedEntry? Entry { get; set; }
}
