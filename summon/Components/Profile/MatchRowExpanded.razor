@using summon.Accounts
@using summon.Data
@inject IServiceScopeFactory ScopeFactory
@inject IpRateLimiter Limiter
@inject ClientIp Client

<div class="border-t">
    @if (failed)
    {
        <EmptyState Title="Match not found" Description="It may be too old or Riot could not be reached." />
    }
    else if (match is null)
    {
        <div class="p-3">
            <Skeleton Class="h-64" />
        </div>
    }
    else if (Queues.IsArena(match.Info.QueueId))
    {
        <ArenaScoreboard Participants="match.Info.Participants" DataDragon="DataDragon" HighlightPuuid="@Puuid" />
        <div class="border-t px-3 py-2 text-center text-xs">@FullMatch</div>
    }
    else
    {
        <MirroredScoreboard Match="match" DataDragon="DataDragon" HighlightPuuid="@Puuid" Footer="FullMatch" Ranks="ranks" RanksLoading="ranks is null" Badges="Badges" />
    }
</div>

@code {
    [Parameter, EditorRequired] public required string MatchId { get; set; }
    [Parameter, EditorRequired] public required string Puuid { get; set; }
    [Parameter, EditorRequired] public required DataDragonData DataDragon { get; set; }
    // Passed when the profile already has the match document; otherwise it is read from the database
    [Parameter] public RiotMatch? Match { get; set; }
    [Parameter] public List<BadgeAssignment>? Badges { get; set; }

    private RiotMatch? match;
    private Dictionary<string, List<RankedEntry>>? ranks;
    private bool failed;

    private RenderFragment FullMatch =>
        @<a href="/match/@MatchId?puuid=@Puuid" class="font-medium text-primary hover:underline">Full match &rarr;</a>;

    protected override async Task OnInitializedAsync()
    {
        // Runs inside the circuit, so it opens its own scope like the profile's loads do
        await using var scope = ScopeFactory.CreateAsyncScope();
        try
        {
            match = Match ?? await scope.ServiceProvider.GetRequiredService<MatchService>().GetMatchAsync(MatchId);
            if (Queues.IsArena(match.Info.QueueId)) return;

            // The scoreboard shows first, then the ranks fill in, like the original fetching them on open
            StateHasChanged();
            var puuids = match.Info.Participants.Select(p => p.Puuid).Distinct().ToList();
            if (Limiter.Limited("ranked-batch", Client))
            {
                ranks = [];
                return;
            }
            ranks = await scope.ServiceProvider.GetRequiredService<RankedService>().GetBatchAsync(Queues.PlatformOf(MatchId), puuids);
        }
        catch (HttpRequestException)
        {
            if (match is null) failed = true;
            else ranks = [];
        }
    }
}
