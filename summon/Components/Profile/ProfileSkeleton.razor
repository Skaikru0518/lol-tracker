@* Shell placeholder while the profile loads: the hero, and unless HeroOnly, the tab bar and the grid *@
<div class="border-b bg-card/40">
    <div class="mx-auto flex max-w-7xl items-end gap-4 px-4 pb-5 pt-20 sm:px-6">
        <Skeleton Class="size-20 rounded-xl" />
        <div class="space-y-2">
            <Skeleton Class="h-7 w-48" />
            <Skeleton Class="h-4 w-20" />
            <Skeleton Class="h-5 w-56" />
        </div>
    </div>
</div>
@if (!HeroOnly)
{
    <div class="mx-auto max-w-7xl space-y-4 px-4 py-6 sm:px-6">
        <Skeleton Class="h-10 w-full" />
        <div class="grid gap-4 lg:grid-cols-[330px_1fr]">
            <Skeleton Class="h-96" />
            <Skeleton Class="h-96" />
        </div>
    </div>
}

@code {
    [Parameter] public bool HeroOnly { get; set; }
}
