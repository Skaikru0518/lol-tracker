@using summon.Accounts

<Panel>
    <div class="flex flex-col gap-2 border-b px-4 py-2.5 sm:flex-row sm:items-center">
        <div class="flex items-center gap-1.5">
            <h2 class="text-sm font-semibold text-foreground">Recent games</h2>
            <PerformanceHelp />
        </div>
        <div class="sm:ml-auto sm:w-auto">
            <MatchFilters Queue="@queue" OnQueueChange="SetQueue" />
        </div>
    </div>

    @if (Games is null || DataDragon is null)
    {
        <div class="space-y-2 p-3">
            @for (var i = 0; i < 6; i++)
            {
                <Skeleton Class="h-16" />
            }
        </div>
    }
    else
    {
        var filtered = Filtered;
        if(filtered.Count == 0)
        {
            <EmptyState Title="@(Games.Count > 0 ? "No games for this filter" : "No matches found")" />
        }
        else
        {
            @foreach(var game in filtered.Take(visible))
            {
                <RecentGame Game="game" Puuid="@Puuid" DataDragon="DataDragon" LpChange="@(LpChanges?.TryGetValue(game.MatchId, out var lp) == true ? lp : null)"
                            Performance="@Performance?.GetValueOrDefault(game.MatchId)" PerformanceLoading="Performance is null"
                            Match="@Matches?.GetValueOrDefault(game.MatchId)" @key="game.MatchId" />
            }
            @if(visible < filtered.Count)
            {
                <div class="p-3">
                    <button type="button" data-slot="button" class="@LoadMoreClass" @onclick="() => visible += PageSize">Load more</button>
                </div>
            }
        }
    }
    </Panel>

@code {
        [Parameter] public List<MatchRow>? Games { get; set; }
        [Parameter] public DataDragonData? DataDragon { get; set; }
        [Parameter, EditorRequired] public required string Puuid { get; set; }
        [Parameter] public IReadOnlyDictionary<string, int>? LpChanges { get; set; }
        // Null while the scores are being calculated, so eligible rows show a skeleton instead of the "no score" mark
        [Parameter] public IReadOnlyDictionary<string, PerformanceScore>? Performance { get; set; }
        // The profile already holds these match documents, so opening a row needs no database read
        [Parameter] public IReadOnlyDictionary<string, RiotMatch>? Matches { get; set; }

    private const int PageSize = 20;
    private string queue = "all";
    private List<MatchRow> Filtered => queue == "all" ? Games! : Games!.Where(g => Queues.Selection(queue).Ids.Contains(g.QueueId)).ToList();
    private void SetQueue(string value)
    {
        queue = value;
        visible = PageSize;
    }

    // The shadcn Button classes for variant "outline", default size, with "w-full"
    private const string LoadMoreClass =
        "group/button inline-flex shrink-0 items-center justify-center gap-1 rounded-md border border-border bg-clip-padding px-2 h-7 w-full text-xs/relaxed font-medium whitespace-nowrap " +
        "transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30 active:translate-y-px " +
        "disabled:pointer-events-none disabled:opacity-50 hover:bg-input/50 hover:text-foreground dark:bg-input/30";

    private int visible = PageSize;
}
