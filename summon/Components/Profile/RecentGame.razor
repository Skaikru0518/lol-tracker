@using summon.Accounts

<div class="border-b last:border-b-0">
    <button type="button" @onclick="Toggle" aria-expanded="@(open ? "true" : "false")"
            class="flex w-full flex-wrap items-center gap-x-3 gap-y-2 bg-gradient-to-r to-transparent to-60% px-3 py-2.5 text-left transition-colors hover:bg-accent/40 sm:flex-nowrap sm:px-4 @Gradient">
        <div class="w-[4.75rem] shrink-0 leading-tight">
            @if (Arena)
            {
                <p class="text-sm font-bold" style="color: @Queues.PlacementColor(Placement)">
                    @Placement<span class="align-super text-3xs">@Queues.PlacementSuffix(Placement)</span>
                </p>
            }
            else
            {
                <p class="text-sm font-bold @ResultColor">@ResultLabel</p>
            }
            <p class="truncate text-2xs text-foreground">@Queues.Short(Game.QueueId)</p>
            <p class="text-3xs text-muted-foreground">@Format.Duration(Game.GameDuration) · @Format.TimeAgo(Game.GameCreation)</p>
        </div>

        @if (Performance is not null)
        {
            <ScoreCircle Score="Performance.Score" Grade="@Performance.Grade" />
        }
        else if (PerformanceLoading && ScoreEngine.IsEligible(Game.QueueId, Game.GameDuration))
        {
            <Skeleton Class="size-9 rounded-full" />
        }
        else
        {
            <ScorePlaceholder />
        }

        <ChampionIcon DataDragon="DataDragon" ChampionName="@Game.ChampionName" Size="44" Level="Game.ChampionLevel" />
        <SpellRuneStack DataDragon="DataDragon" Spell1="Game.Spell1" Spell2="Game.Spell2" Keystone="Game.Keystone" SecondaryStyle="Game.SecondaryStyle" Display="hidden sm:grid" />

        <div class="w-24 leading-tight">
            <p class="whitespace-nowrap text-base font-bold text-foreground">
                @Game.Kills / <span class="text-loss">@Game.Deaths</span> / @Game.Assists
            </p>
            <p class="text-2xs text-muted-foreground">@(Kda is null ? "Perfect" : $"{Kda} KDA")</p>
        </div>

        <div class="hidden gap-1 md:flex">
            @if (!Arena)
            {
                @Stat(Game.Cs.ToString(), $"CS {Format.CsPerMinute(Game.Cs, Game.GameDuration)}")
            }
            @Stat($"{Format.Percent(Game.Kills + Game.Assists, Game.TeamKills)}%", "KP")
            @if (Ranks.QueueForQueueId(Game.QueueId) is not null)
            {
                @Stat(LpChange is { } lp ? $"{(lp >= 0 ? "+" : "")}{lp}" : "—", "LP",
                    LpChange is null ? "text-muted-foreground" : LpChange >= 0 ? "text-win" : "text-loss")
            }
        </div>

        <div class="ml-auto flex basis-full flex-col items-start gap-1 sm:basis-auto sm:items-end">
            <ItemSlots DataDragon="DataDragon" Items="Game.Items" Size="22" />
        </div>

        @* Lucide "chevron-down" icon *@
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-muted-foreground transition-transform @(open ? "rotate-180" : "")" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
        </svg>
    </button>

    @if (mounted)
    {
        @* Grid rows between 0fr and 1fr animate to the content's own height: a keyframe on first show, a transition after *@
        <div class="grid transition-all duration-[180ms] @(open ? "animate-expand grid-rows-[1fr] opacity-100" : "grid-rows-[0fr] opacity-0")">
            <div class="overflow-hidden" inert="@(!open)">
                <MatchRowExpanded MatchId="@Game.MatchId" Puuid="@Puuid" DataDragon="DataDragon" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required MatchRow Game { get; set; }
    [Parameter, EditorRequired] public required string Puuid { get; set; }
    [Parameter, EditorRequired] public required DataDragonData DataDragon { get; set; }
    [Parameter] public int? LpChange { get; set; }
    [Parameter] public PerformanceScore? Performance { get; set; }
    [Parameter] public bool PerformanceLoading { get; set; }

    private bool open;
    private bool mounted;

    private bool Arena => Queues.IsArena(Game.QueueId);
    private int Placement => Game.Placement is > 0 and var placement ? placement : Game.Win ? 1 : 5;

    // Remakes first, then Arena's top four or the win flag
    private string Result => Queues.IsRemake(Game.GameDuration) ? "remake" : (Arena ? Placement <= 4 : Game.Win) ? "win" : "loss";
    private string ResultLabel => Result switch { "win" => "Victory", "loss" => "Defeat", _ => "Remake" };
    private string ResultColor => Result switch { "win" => "text-win", "loss" => "text-loss", _ => "text-muted-foreground" };
    private string Gradient => Result switch { "win" => "from-win/20", "loss" => "from-loss/20", _ => "from-muted/40" };

    private string? Kda => Format.Kda(Game.Kills, Game.Deaths, Game.Assists);

    private void Toggle()
    {
        mounted = true;
        open = !open;
    }

    private static RenderFragment Stat(string value, string label, string className = "text-foreground") =>
        @<div class="w-11 text-center leading-tight">
            <p class="text-sm font-semibold @className">@value</p>
            <p class="text-3xs text-muted-foreground">@label</p>
        </div>;
}
