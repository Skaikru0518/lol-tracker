@* 5 vs 5 champion buttons; the selected player gets the gold ring *@
<div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Select player">
    @foreach (var (teamId, index) in new[] { (100, 0), (200, 1) })
    {
        <div class="flex gap-1.5 @(index == 1 ? "sm:ml-4" : "")" @key="teamId">
            @foreach (var p in Match.Info.Participants.Where(p => p.TeamId == teamId))
            {
                <button type="button" @key="p.Puuid" @onclick="() => OnSelect.InvokeAsync(p.Puuid)" aria-pressed="@(p.Puuid == Selected ? "true" : "false")"
                        title="@($"{p.RiotIdGameName} · {DataDragon.ChampionName(p.ChampionName)}")"
                        class="rounded-md border-2 transition-colors @(p.Puuid == Selected ? "border-gold" : "border-transparent opacity-70 hover:opacity-100")">
                    <ChampionIcon DataDragon="DataDragon" ChampionName="@p.ChampionName" Size="36" />
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required RiotMatch Match { get; set; }
    [Parameter, EditorRequired] public required DataDragonData DataDragon { get; set; }
    [Parameter, EditorRequired] public required string Selected { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }
}
