@* Objectives on a blue (top) and red (bottom) lane (grubs merged per wave), kill ticks with tooltips along the axis, the firsts and counts, and a collapsible list *@
<Panel>
    <PanelHeader Title="Objectives" />
    <div class="relative mx-4 my-4 h-36">
        <div class="absolute inset-x-0 top-0 h-12 rounded-md bg-team-blue/10"></div>
        <div class="absolute inset-x-0 bottom-0 h-12 rounded-md bg-team-red/10"></div>
        <div class="absolute inset-x-0 top-[3.75rem] flex h-4 justify-between border-y border-dashed text-3xs text-muted-foreground">
            @for (var m = 0; m <= end / 300_000; m++)
            {
                <span class="absolute -translate-x-1/2 leading-4" style="left: @Left(m * 5 * 60_000L)">@(m * 5)</span>
            }
        </div>
        @foreach (var (k, i) in kills.Select((k, i) => (k, i)))
        {
            <span class="absolute -translate-x-1/2 @(k.Side == "blue" ? "top-[2.875rem]" : "top-[4.75rem]")" style="left: @Left(k.Timestamp)" @key="@($"k{i}")">
                <Tooltip Text="@KillText(k)">
                    <span class="block h-3.5 w-1 cursor-pointer rounded-sm transition-transform hover:scale-125 @(k.Side == "blue" ? "bg-team-blue" : "bg-team-red")"></span>
                </Tooltip>
            </span>
        }
        @foreach (var (o, i) in objectives.Select((o, i) => (o, i)))
        {
            <span class="absolute -translate-x-1/2 @(o.Side == "blue" ? "top-3" : "bottom-3")" style="left: @Left(o.Timestamp)" @key="@($"o{i}")">
                <Tooltip Text="@($"{o.Label} · {MatchPageUi.SideName(o.Side)} · {Clock(o.Timestamp)}")">
                    <img src="@o.Icon" alt="@o.Label" class="size-6 cursor-pointer rounded-full border-2 bg-card p-0.5 transition-transform hover:scale-110 @(o.Side == "blue" ? "border-team-blue" : "border-team-red")" />
                </Tooltip>
            </span>
        }
    </div>
    <div class="flex flex-wrap gap-1.5 px-4 pb-4">
        @First("First blood", summary.FirstBlood)
        @First("First tower", summary.FirstTower)
        @First("First dragon", summary.FirstDragon)
        @foreach (var key in new[] { "dragons", "grubs", "barons", "towers" })
        {
            <span class="rounded-md border px-2 py-1 text-xs capitalize">
                @key <b class="text-team-blue">@summary.Counts[key].Blue</b>–<b class="text-team-red">@summary.Counts[key].Red</b>
            </span>
        }
    </div>
    <button type="button" @onclick="() => open = !open"
            class="flex w-full items-center justify-center gap-1 border-t py-2 text-xs font-medium text-muted-foreground hover:text-foreground">
        Event list
        @* Lucide "chevron-down" icon *@
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 transition-transform @(open ? "rotate-180" : "")" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
        </svg>
    </button>
    @if (open)
    {
        <ul class="divide-y divide-border/50 border-t">
            @foreach (var (o, i) in objectives.Select((o, i) => (o, i)))
            {
                <li class="flex items-center gap-2 px-4 py-1.5 text-sm" @key="@($"l{i}")">
                    <span class="w-11 tabular-nums text-muted-foreground">@Clock(o.Timestamp)</span>
                    <img src="@o.Icon" alt="" width="18" height="18" class="size-4.5" />
                    <span class="text-foreground">@o.Label</span>
                    <span class="ml-auto text-xs font-semibold @(o.Side == "blue" ? "text-team-blue" : "text-team-red")">@MatchPageUi.SideName(o.Side)</span>
                </li>
            }
        </ul>
    }
</Panel>

@code {
    [Parameter, EditorRequired] public required RiotTimeline Timeline { get; set; }
    [Parameter, EditorRequired] public required RiotMatch Match { get; set; }
    [Parameter, EditorRequired] public required DataDragonData DataDragon { get; set; }

    private List<ObjectiveEvent> objectives = [];
    private List<KillTick> kills = [];
    private ObjectiveSummary summary = null!;
    private long end;
    private bool open;

    protected override void OnParametersSet()
    {
        var raw = TimelineEvents.ObjectiveEvents(Timeline);
        objectives = TimelineEvents.GrubWaves(raw);
        kills = TimelineEvents.KillTicks(Timeline);
        // Counts use the unmerged events so grubs are counted one by one
        summary = TimelineEvents.Summary(raw, kills);
        end = TimelineEvents.GameEndMs(Timeline);
    }

    private string Left(long ms) => $"{Math.Min(ms * 100.0 / end, 100).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}%";

    private static string Clock(long ms) => Format.Duration((int)(ms / 1000));

    private string PlayerLabel(int id) =>
        Match.Info.Participants.ElementAtOrDefault(id - 1) is { } p ? $"{p.RiotIdGameName} ({DataDragon.ChampionName(p.ChampionName)})" : "Unknown";

    private string KillText(KillTick tick)
    {
        var victim = PlayerLabel(tick.VictimId);
        var what = tick.KillerId > 0 ? $"{PlayerLabel(tick.KillerId)} killed {victim}" : $"{victim} was executed";
        return $"{what} · {Clock(tick.Timestamp)}";
    }

    private static RenderFragment First(string label, FirstTaken? taken) =>
        @<span class="rounded-md border px-2 py-1 text-xs">
            @label@(" ")@if (taken is not null)
            {
                <b class="@(taken.Side == "blue" ? "text-team-blue" : "text-team-red")">@MatchPageUi.SideName(taken.Side)</b>@(" ")<span class="text-muted-foreground">@Clock(taken.Timestamp)</span>
            }
            else
            {
                <span class="text-muted-foreground">—</span>
            }
        </span>;
}
