@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<WidgetGenerator> Logger

@* Pick a style, preview it with this summoner's data (sample games when the session is empty), copy the OBS URL *@
<div class="grid gap-5 md:grid-cols-[18rem_minmax(0,1fr)]">
    <div class="grid content-start gap-4">
        @Segmented("Style", WidgetOptions.Styles, options.Style, v => options = options with { Style = v })
        @Segmented("Theme", WidgetOptions.Themes, options.Theme, v => options = options with { Theme = v })
        @Segmented("Queue", WidgetOptions.Queues, options.Queue, v => SetData(options with { Queue = v }))
        <div class="grid gap-1.5">
            @Segmented("Record", WidgetOptions.Sessions, options.Session, v => SetData(options with { Session = v }))
            <span class="text-xs text-muted-foreground">
                @(options.Session switch
                {
                    "auto" => "A new session starts after 3 hours without a game.",
                    "today" => "Counts from your local midnight.",
                    "load" => "Counts from when OBS loads the widget.",
                    _ => "This season's ranked record in the queue, with your latest games. No LP change.",
                })
            </span>
        </div>
        <div class="grid grid-cols-[auto_minmax(0,1fr)] rounded-lg border bg-secondary/40 py-3">
            <div class="grid content-start gap-2 px-3">
                <span class="text-xs font-medium text-muted-foreground">Show</span>
                @foreach (var part in WidgetLogic.StyleParts(options.Style).Where(p => p != "lp" || options.Session != "season"))
                {
                    <label class="@CheckLabel" @key="part">
                        <input type="checkbox" class="accent-primary" checked="@options.Show.Contains(part)" @onchange="() => TogglePart(part)" />
                        @Labels[part]
                    </label>
                }
            </div>
            <div class="grid content-start gap-2 border-l px-3">
                <span class="text-xs font-medium text-muted-foreground">Motion</span>
                <label class="@CheckLabel">
                    <input type="checkbox" class="accent-primary" checked="@options.Animated" @onchange="ToggleAnim" />
                    Animations
                </label>
                @foreach (var fx in Effects)
                {
                    <label class="@CheckLabel" @key="fx">
                        <input type="checkbox" class="accent-primary" checked="@options.HasFx(fx)" @onchange="() => ToggleFx(fx)" />
                        @(fx == "rotate" ? options.Style == "bar" ? "Session ↔ Season" : "Rank ↔ Record" : Labels[fx])
                    </label>
                }
            </div>
        </div>
    </div>

    <div class="grid min-w-0 content-start gap-3">
        <div class="relative grid min-h-48 place-items-center overflow-hidden rounded-lg p-4" style="@Checkerboard">
            @if (preview is { } p)
            {
                <StreamWidget Data="p.Data" Options="options" Events="events" DataDragon="dataDragon" />
            }
            else
            {
                <span class="text-xs text-muted-foreground">@(failed ? "Preview unavailable" : "Loading preview…")</span>
            }
            @if (preview is { Sample: true })
            {
                <span class="absolute right-2 top-2 rounded bg-black/60 px-1.5 py-0.5 text-2xs text-white">Sample session</span>
            }
            @if (options.Animated && preview is not null)
            {
                <div class="absolute bottom-2 right-2 flex gap-1">
                    <button type="button" data-slot="button" class="@PlayButton" @onclick="() => Play(promotion: false)">Play win</button>
                    <button type="button" data-slot="button" class="@PlayButton" @onclick="() => Play(promotion: true)">Play promotion</button>
                </div>
            }
        </div>
        <div class="flex min-w-0 gap-2">
            <code class="min-w-0 flex-1 truncate rounded-md border bg-secondary px-2.5 py-1.5 text-xs">@Url</code>
            <button type="button" data-slot="button" class="@CopyButton" @onclick="CopyAsync">@(copied ? "Copied" : "Copy URL")</button>
            <a href="@Url" target="_blank" rel="noreferrer" data-slot="button" class="@OpenButton">Open</a>
        </div>
        <p class="text-xs leading-relaxed text-muted-foreground">
            <span class="font-medium text-foreground">OBS:</span> Sources → + → Browser, paste the URL, width @Size.Width, height @Size.Height.
            The background is transparent, no custom CSS needed. It refreshes itself every minute.
        </p>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required string Slug { get; set; }

    private static readonly Dictionary<string, string> Labels = new()
    {
        ["bar"] = "Bar", ["square"] = "Square", ["strip"] = "Strip", ["pill"] = "Pill",
        ["card"] = "Card", ["clear"] = "Clear", ["solo"] = "Solo/Duo", ["flex"] = "Flex",
        ["auto"] = "Auto", ["today"] = "Today", ["load"] = "On load", ["season"] = "Overall",
        ["id"] = "Riot ID", ["server"] = "Server", ["lp"] = "LP change", ["wr"] = "Win rate %", ["smoke"] = "Rank Animation",
    };

    private const string CheckLabel = "flex items-center gap-2 text-[0.8125rem] leading-tight whitespace-nowrap";
    private const string Checkerboard = "background: repeating-conic-gradient(#2a2d3a 0 25%, #1c1e28 0 50%) 0 0 / 20px 20px";
    // The shadcn Button classes for each variant and size the original uses
    private const string ButtonBase =
        "group/button inline-flex shrink-0 items-center justify-center rounded-md border border-transparent bg-clip-padding text-xs/relaxed font-medium whitespace-nowrap transition-all outline-none select-none " +
        "focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30 active:translate-y-px disabled:pointer-events-none disabled:opacity-50 ";
    private const string PlayButton = ButtonBase + "bg-secondary text-secondary-foreground hover:bg-secondary/80 h-5 gap-1 rounded-sm px-2 text-[0.625rem]";
    private const string CopyButton = ButtonBase + "bg-primary text-primary-foreground hover:bg-primary/80 h-8 gap-1 px-2.5";
    private const string OpenButton = ButtonBase + "border-border hover:bg-input/50 hover:text-foreground dark:bg-input/30 h-8 gap-1 px-2.5";

    private WidgetOptions options = WidgetLogic.Default;
    private WidgetEvents? events;
    private CancellationTokenSource? clearEvents;
    private (WidgetData Data, bool Sample)? preview;
    private DataDragonData? dataDragon;
    private bool failed;
    private bool copied;
    // Real data per queue and record choice, kept for a minute like the original's query cache
    private readonly Dictionary<string, (WidgetData Data, DateTime At)> loaded = [];

    private IEnumerable<string> Effects => options.Style is "bar" or "pill" ? ["rotate", "smoke"] : ["smoke"];
    private string Url => $"{Navigation.BaseUri}widget/{Slug}?{WidgetLogic.OptionsQuery(options)}";
    private (int Width, int Height) Size => WidgetLogic.StyleSizes[options.Style];

    protected override Task OnInitializedAsync() => LoadAsync();

    private void SetData(WidgetOptions next)
    {
        options = next;
        _ = LoadAsync();
    }

    private async Task LoadAsync()
    {
        var key = $"{options.Queue}:{options.Session}";
        if (loaded.TryGetValue(key, out var hit) && DateTime.UtcNow - hit.At < TimeSpan.FromMinutes(1))
        {
            preview = WidgetLogic.WithSampleSession(hit.Data);
            return;
        }
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            dataDragon ??= await scope.ServiceProvider.GetRequiredService<DataDragon>().GetAsync();
            var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            // shortcut: "today" previews count from the server's midnight (UTC); the widget itself asks the viewer's browser
            var midnight = new DateTimeOffset(DateTime.UtcNow.Date, TimeSpan.Zero).ToUnixTimeMilliseconds();
            var data = await scope.ServiceProvider.GetRequiredService<WidgetDataService>()
                .BuildAsync(Slug, WidgetLogic.Query(options with { Style = "strip" }, now, midnight), now);
            if (data is null)
            {
                failed = true;
                return;
            }
            loaded[key] = (data, DateTime.UtcNow);
            preview = WidgetLogic.WithSampleSession(data);
            failed = false;
        }
        catch (Exception e)
        {
            // An exception here would end the circuit; the preview says it is unavailable
            Logger.LogError(e, "Widget preview failed for {Slug}", Slug);
            failed = true;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void TogglePart(string part) =>
        options = options with { Show = options.Show.Contains(part) ? options.Show.Where(p => p != part).ToList() : [.. options.Show, part] };

    private void ToggleAnim() => options = options with { Anim = options.Animated ? "off" : "on" };

    private void ToggleFx(string fx) =>
        options = options with { Fx = options.HasFx(fx) ? options.Fx.Where(f => f != fx).ToList() : [.. options.Fx, fx] };

    private void Play(bool promotion)
    {
        var newest = preview?.Data.Games.LastOrDefault()?.MatchId;
        events = new WidgetEvents(newest is null ? [] : [newest], "win", promotion ? 24 : 20, promotion ? "up" : null, DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());
        clearEvents?.Cancel();
        clearEvents = new CancellationTokenSource();
        var token = clearEvents.Token;
        _ = Task.Delay(3500, token).ContinueWith(_ => InvokeAsync(() =>
        {
            events = null;
            StateHasChanged();
        }), token, TaskContinuationOptions.OnlyOnRanToCompletion, TaskScheduler.Default);
    }

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Url);
            // shortcut: the original confirms with a toast; switch when toasts exist
            copied = true;
            StateHasChanged();
            await Task.Delay(2000);
            copied = false;
        }
        catch (JSException)
        {
            // Clipboard blocked: the URL stays selectable in the box
        }
    }

    private RenderFragment Segmented(string label, string[] values, string value, Action<string> onChange) =>
        @<div class="grid gap-1.5">
            <span class="text-xs font-medium text-muted-foreground">@label</span>
            <div class="flex gap-0.5 rounded-lg bg-secondary p-0.5">
                @foreach (var v in values)
                {
                    <button type="button" @key="v" @onclick="() => onChange(v)"
                            class="flex-1 rounded-md py-1 text-xs font-medium text-muted-foreground transition-colors @(v == value ? "bg-card text-foreground shadow-sm ring-1 ring-border" : "")">
                        @Labels[v]
                    </button>
                }
            </div>
        </div>;
}
