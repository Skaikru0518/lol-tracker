@if (Participant is null)
{
    <div class="h-13"></div>
}
else
{
    var p = Participant;
    <div class="flex h-13 items-center gap-2 px-2 @(Side == "red" ? "flex-row-reverse" : "") @(Highlighted ? "bg-gold/10" : "")">
        <ChampionIcon DataDragon="DataDragon" ChampionName="@p.ChampionName" Size="28" Level="p.ChampLevel" />
        <div class="flex shrink-0 flex-col gap-0.5">
            @foreach (var (runeId, i) in new[] { p.Keystone, p.SecondaryStyle }.Select((id, i) => (id, i)))
            {
                var src = DataDragon.RuneIcon(runeId);
                if (src is null)
                {
                    <span class="rounded-full bg-muted" style="@Css.Square(13)"></span>
                }
                else
                {
                    <img src="@src" alt="" width="13" height="13" style="@Css.Square(13)" class="rounded-full @(i == 0 ? "bg-black/40" : "")" />
                }
            }
        </div>
        <div class="@NameColumn @(Side == "red" ? "text-right" : "")">
            <a href="/summoner/@Format.SummonerSlug(p.RiotIdGameName, p.RiotIdTagline)"
               class="block truncate text-xs font-semibold hover:text-primary @(Highlighted ? "text-gold" : "text-foreground")">
                @p.RiotIdGameName
            </a>
        </div>
        <div class="w-24 shrink-0 whitespace-nowrap text-center leading-tight">
            <p class="text-xs font-semibold text-foreground">@p.Kills/@p.Deaths/@p.Assists</p>
            <p class="text-3xs text-muted-foreground">@(p.TotalMinionsKilled + p.NeutralMinionsKilled) CS · @Format.Thousands(p.GoldEarned)</p>
        </div>
        <ItemSlots DataDragon="DataDragon" Items="@(new[] { p.Item0, p.Item1, p.Item2, p.Item3, p.Item4, p.Item5, p.Item6 })" Size="17" Display="@ItemsDisplay" />
    </div>
}

@code {
    [Parameter] public RiotParticipant? Participant { get; set; }
    [Parameter, EditorRequired] public required string Side { get; set; }
    [Parameter, EditorRequired] public required DataDragonData DataDragon { get; set; }
    [Parameter] public bool Highlighted { get; set; }

    // Container query classes live in C# strings: in markup Razor would read "@sm" as code
    private const string NameColumn = "w-24 min-w-0 leading-tight @sm:w-28";
    private const string ItemsDisplay = "hidden @sm:flex";
}
