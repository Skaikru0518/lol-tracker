@* Hover tooltip in the shadcn style. wwwroot/tooltip.js opens the body as a popover after the same 200 ms delay:
   in the top layer no panel clips it, and closed it takes no room, so it never widens the page *@
<span class="relative inline-flex @Class" data-tip="@Side">
    @ChildContent
    <span role="tooltip" popover="manual"
          class="tip pointer-events-none inset-auto m-0 w-max max-w-xs items-center gap-1.5 overflow-visible rounded-md border-0 bg-foreground px-3 py-1.5 text-xs text-background transition-opacity open:inline-flex starting:open:opacity-0 dark:bg-secondary dark:text-foreground">
        @if (Content is not null)
        {
            @Content
        }
        else
        {
            @Text
        }
        <span class="tip-arrow absolute size-2.5 rotate-45 rounded-[2px] bg-foreground dark:bg-secondary"></span>
    </span>
</span>

@code {
    [Parameter] public string? Text { get; set; }
    // Richer tooltip body; takes the place of Text when set
    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter, EditorRequired] public required RenderFragment ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    // "top" (default) or "right"; either flips when the viewport has no room on that side
    [Parameter] public string Side { get; set; } = "top";
}
