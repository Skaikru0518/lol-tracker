<span data-slot="chip" class="inline-flex h-5 items-center gap-1 whitespace-nowrap rounded border px-1.5 text-3xs font-semibold hover:cursor-pointer @Class" style="@Style">
    @ChildContent
</span>

@code {
    [Parameter, EditorRequired] public required string Color { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter, EditorRequired] public required RenderFragment ChildContent { get; set; }

    // Like the original's chipStyle: a hex color gets a 44 alpha border and a 20 alpha fill, a var(--token) is mixed
    // with transparency instead, and anything else (an empty color) renders muted
    private string Style
    {
        get
        {
            var color = Color.Trim();
            if (color.StartsWith("var(--", StringComparison.Ordinal) && color.EndsWith(')'))
                return $"color: {color}; border-color: color-mix(in srgb, {color} 27%, transparent); background-color: color-mix(in srgb, {color} 13%, transparent)";
            // Six-digit hex only: every hex color passed here is already #rrggbb
            if (color.Length == 7 && color[0] == '#' && color[1..].All(char.IsAsciiHexDigit))
                return $"color: {color}; border-color: {color}44; background-color: {color}20";
            return "color: var(--color-muted-foreground); border-color: var(--color-border); background-color: transparent";
        }
    }
}
