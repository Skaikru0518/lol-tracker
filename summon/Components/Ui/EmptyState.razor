<div class="flex flex-col items-center justify-center gap-1.5 px-4 py-8 text-center @Class">
    <p class="text-sm font-medium text-foreground">@Title</p>
    @if (Description is not null)
    {
        <p class="max-w-xs text-xs text-muted-foreground">@Description</p>
    }
    @if (Action is not null)
    {
        <div class="mt-2">@Action</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Action { get; set; }
    [Parameter] public string? Class { get; set; }
}
