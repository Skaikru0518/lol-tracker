@using summon.Riot

<span class="relative inline-block shrink-0 @Class" style="@Css.Square(Size)">
    <img src="@DataDragon.ChampionIcon(ChampionName)" alt="@ChampionName" width="@Size" height="@Size" class="size-full rounded-md object-cover" />
    @if (Level is not null)
    {
        <span class="absolute -bottom-1 -right-1 rounded-md border bg-background px-1 text-3xs leading-tight text-foreground">@Level</span>
    }
</span>

@code {
    [Parameter, EditorRequired] public required DataDragonData DataDragon { get; set; }
    [Parameter, EditorRequired] public required string ChampionName { get; set; }
    [Parameter] public int Size { get; set; } = 32;
    [Parameter] public int? Level { get; set; }
    [Parameter] public string? Class { get; set; }
}
