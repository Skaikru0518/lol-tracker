@* Full-width message screen with an optional champion splash, a big code or title and action buttons below *@
<HeroBanner SplashUrl="@(Splash is null ? null : DataDragonData.ChampionSplash(Splash))" ObjectPosition="center 30%" Class="min-h-[70vh] border-b">
    <div class="mx-auto flex min-h-[70vh] max-w-xl flex-col items-center justify-center gap-4 px-4 py-16 text-center">
        @if (Code is not null)
        {
            <p class="text-7xl font-bold tracking-tight text-primary">@Code</p>
        }
        <h1 class="text-2xl font-bold text-foreground">@Title</h1>
        <p class="text-muted-foreground">@Description</p>
        @if (ChildContent is not null)
        {
            <div class="mt-2 flex w-full flex-col items-center gap-3">@ChildContent</div>
        }
    </div>
</HeroBanner>

@code {
    [Parameter] public string? Code { get; set; }
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter, EditorRequired] public required string Description { get; set; }
    [Parameter] public string? Splash { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
