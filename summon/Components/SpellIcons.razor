@using summon.Riot

<div class="grid gap-0.5">
    @foreach (var spell in new[] { Spell1, Spell2 })
    {
        var icon = DataDragon.SpellIcon(spell);
        if (icon is null)
        {
            <span class="@Size rounded bg-secondary"></span>
        }
        else
        {
            <img src="@icon" alt="" class="@Size rounded" />
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public required DataDragonData DataDragon { get; set; }
    [Parameter, EditorRequired] public int Spell1 { get; set; }
    [Parameter, EditorRequired] public int Spell2 { get; set; }
    [Parameter] public string Size { get; set; } = "size-[1.125rem]";
}
